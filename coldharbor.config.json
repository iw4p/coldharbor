{
  "router": {
    "type": "hybrid",
    "baseUrl": "https://api.typesafe.ai",
    "model": "jev-latest",
    "apiKey": "${JEV_API_KEY}"
  },
  "llm": {
    "provider": "openai",
    "baseUrl": "https://api.groq.com/openai/v1",
    "model": "qwen/qwen3.8-27b",
    "apiKey": "${GROQ_API_KEY}"
  },
  "mcpServers": {
    "weather": {
      "command": "npx",
      "args": [
        "-y",
        "open-meteo-mcp-server@2.5.0"
      ]
    },
    "crypto": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/coingecko-mcp-server@0.1.3"
      ]
    },
    "hackernews": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-hacker-news@1.0.3"
      ]
    },
    "earthquakes": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/earthquake-mcp-server@0.3.7"
      ]
    },
    "worldbank": {
      "command": "npx",
      "args": [
        "-y",
        "worldbank-mcp@1.0.1"
      ]
    },
    "arxiv": {
      "command": "npx",
      "args": [
        "-y",
        "@cyanheads/arxiv-mcp-server@1.5.3"
      ]
    },
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio",
        "--read-only"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "files": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    }
  }
}
