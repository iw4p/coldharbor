# Copy to .env.local (gitignored) and fill in what you use.

# System One: Jev, hosted by TypeSafe (https://docs.typesafe.ai/api). Not needed if you run Kev yourself.
JEV_API_KEY=

# The LLM: any OpenAI-compatible API. The default config uses Groq (https://console.groq.com/keys).
GROQ_API_KEY=

# Optional: the official GitHub MCP server.
GITHUB_TOKEN=

# Optional: a CoinGecko demo key for a higher rate limit. Also add
# "env": { "COINGECKO_API_KEY": "${COINGECKO_API_KEY}" } to the crypto server in coldharbor.config.json.
COINGECKO_API_KEY=
